{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/usuarios.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/productos.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/ubicaciones.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/stock.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/stock-lotes.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/movimientos.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/productos-movimientos.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/errores-movimientos.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    },
    "api/administracion/terceros.ts": {
      "includeFiles": "node_modules/{pg,pg-cloudflare,pg-connection-string,pg-int8,pg-pool,pg-protocol,pg-types,pgpass,postgres-array,postgres-bytea,postgres-date,postgres-interval,split2,xtend}/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/autenticacion?accion=login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/autenticacion?accion=logout"
    },
    {
      "source": "/api/session",
      "destination": "/api/autenticacion?accion=session"
    },
    {
      "source": "/api/actividad",
      "destination": "/api/autenticacion?accion=actividad"
    },
    {
      "source": "/api/usuarios/:accion",
      "destination": "/api/usuarios"
    },
    {
      "source": "/api/empresa",
      "destination": "/api/usuarios?accion=empresa"
    },
    {
      "source": "/api/plataforma",
      "destination": "/api/usuarios?accion=plataforma"
    },
    {
      "source": "/api/plataforma-modulos",
      "destination": "/api/usuarios?accion=gestion_modulos"
    },
    {
      "source": "/api/plataforma-conciliacion",
      "destination": "/api/usuarios?accion=conciliacion_modulos"
    },
    {
      "source": "/api/plataforma-conciliacion-core",
      "destination": "/api/usuarios?accion=conciliacion_core_global"
    },
    {
      "source": "/api/sucursales",
      "destination": "/api/usuarios?accion=sucursales"
    }
  ]
}
